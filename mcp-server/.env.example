# ============================================================
# ARIA MCP Server — Environment Variables
# Copy to .env and fill in your values.
# ============================================================

MCP_SERVER_PORT=8080
RUST_LOG=info

# ---- LLM Configuration -------------------------------------
# ARIA supports three LLM providers. Pick one via LLM_MODE.
#
#   ai_studio  → Google AI Studio (API key)
#   vertex_ai  → Vertex AI (GCP IAM, service account)
#   openrouter → OpenRouter (multi-model, ordered fallback)
#
# For local development, set LLM_MODE=ai_studio and provide
# GOOGLE_AI_STUDIO_API_KEY. For OpenRouter, set LLM_MODE=openrouter
# and provide OPENROUTER_API_KEY + OPENROUTER_MODELS.
LLM_MODE=ai_studio

# ---- Mode 1: Google AI Studio (local/demo) -----------------
GOOGLE_AI_STUDIO_API_KEY=

# ---- Mode 2: Vertex AI (production) ------------------------
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEXAI_LOCATION=asia-southeast2
GEMINI_MODEL=gemini-2.5-pro

# ---- Mode 3: OpenRouter (multi-model fallback) -------------
# Get your API key at https://openrouter.ai/settings/keys
# NEVER commit real keys to source control.
OPENROUTER_API_KEY=
# Comma-separated ordered list of model IDs. OpenRouter tries
# each in order on the server side when the primary is unavailable.
# Example: OPENROUTER_MODELS=anthropic/claude-sonnet-4,openai/gpt-4o,google/gemini-2.5-flash
OPENROUTER_MODELS=
# Privacy routing policy. Defaults to strict when unset.
#   strict           → requires ZDR and denies data collection
#   training_opt_out → omits ZDR but still denies data collection
# Unknown values fail startup; there is no automatic privacy downgrade.
OPENROUTER_PRIVACY_MODE=strict

# ---- External APIs -----------------------------------------
# OpenFDA (key required): https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=your-openfda-api-key
# RxNorm  (no key): https://rxnav.nlm.nih.gov/RxNormAPIs.html
# PubMed  (no key): https://www.ncbi.nlm.nih.gov/home/develop/api/
# DrugBank Open (no key): https://go.drugbank.com/releases/latest#open-data
